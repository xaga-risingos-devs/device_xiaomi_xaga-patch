From fb91aa398749544b95c674f9b545146adf52de6b Mon Sep 17 00:00:00 2001
From: Hecheng Yu <kde-yyds@qq.com>
Date: Fri, 8 May 2026 18:24:08 +0800
Subject: [PATCH] AnimationUtils: Implemented downgraded AOSP transition for
 mtk devices

without edge extend which is laggy on mtk
---
 .../view/animation/AnimationUtils.java        | 68 +++++++++++++------
 1 file changed, 47 insertions(+), 21 deletions(-)

diff --git a/core/java/android/view/animation/AnimationUtils.java b/core/java/android/view/animation/AnimationUtils.java
index e5491e5d6..c60457ff3 100644
--- a/core/java/android/view/animation/AnimationUtils.java
+++ b/core/java/android/view/animation/AnimationUtils.java
@@ -535,37 +535,53 @@ public class AnimationUtils {
         private static Animation sCloseEnter;
         private static Animation sCloseExit;
 
-        private static SpringInterpolator sSpatialSpec;
-        private static SpringInterpolator sEffectsSpec;
+        // Custom interpolators for Android 16 style
+        private static Interpolator sAospTransitionInterpolator;
+        private static Interpolator sLinearInterpolator;
 
-        private static final float DISTANCE = 0.333f;
+        // Slide distance: 0.2 (20% of the screen) and Translation duration: 450ms
+        private static final float DISTANCE = 0.2f;
+        private static final long TRANSLATE_DURATION_MS = 450L;
 
         private ActivityAnimations() {}
 
         /** @hide */
         public static void preload(Context context) {
-            sSpatialSpec = new SpringInterpolator(0.8f, 380f);
-            sEffectsSpec = new SpringInterpolator(1.0f, 3800f);
+            // Load interpolators once during preload
+            if (sAospTransitionInterpolator == null) {
+                sAospTransitionInterpolator = AnimationUtils.loadInterpolator(
+                        context, com.android.internal.R.interpolator.fast_out_extra_slow_in);
+            }
+            if (sLinearInterpolator == null) {
+                sLinearInterpolator = new LinearInterpolator(); // For alpha fades
+            }
+
+            // Build all animations during ActivityThread bind to remove launch latency
             sOpenEnter = new ActivityAnimFactory()
-                    .fromX(1.0f)
+                    .fromX(DISTANCE)
                     .toX(0.0f)
-                    .fade(0.0f, 1.0f)
+                    // XML: 0 -> 1.0, duration 83, startOffset 50
+                    .fade(0.0f, 1.0f, 83L, 50L)
                     .build();
+
             sOpenExit = new ActivityAnimFactory()
                     .fromX(0.0f)
                     .toX(-DISTANCE)
-                    .fade(1.0f, 0.0f)
+                    // No fade out for background exiting page
                     .build();
+
             sCloseEnter = new ActivityAnimFactory()
-                        .fromX(-DISTANCE)
-                        .toX(0.0f)
-                        .fade(0.0f, 1.0f)
-                        .build();
+                    .fromX(-DISTANCE)
+                    .toX(0.0f)
+                    // No fade in for background re-entering page
+                    .build();
+
             sCloseExit = new ActivityAnimFactory()
-                        .fromX(0.0f)
-                        .toX(1.0f)
-                        .fade(1.0f, 0.0f)
-                        .build();
+                    .fromX(0.0f)
+                    .toX(DISTANCE)
+                    // XML: 1.0 -> 0.0, duration 83, startOffset 35
+                    .fade(1.0f, 0.0f, 83L, 35L)
+                    .build();
         }
 
         private static int loadBackdropColor(Context context) {
@@ -576,6 +592,8 @@ public class AnimationUtils {
         private static class ActivityAnimFactory {
             private float fromX = 0f, toX = 0f;
             private float fromAlpha = 1f, toAlpha = 1f;
+            private long alphaDuration = TRANSLATE_DURATION_MS;
+            private long alphaOffset = 0L;
 
             public ActivityAnimFactory fromX(float ratio) {
                 this.fromX = ratio;
@@ -587,29 +605,37 @@ public class AnimationUtils {
                 return this;
             }
 
-            public ActivityAnimFactory fade(float from, float to) {
+            public ActivityAnimFactory fade(float from, float to, long duration, long offset) {
                 this.fromAlpha = from;
                 this.toAlpha = to;
+                this.alphaDuration = duration;
+                this.alphaOffset = offset;
                 return this;
             }
 
             public Animation build() {
                 AnimationSet animationSet = new AnimationSet(false);
+
+                // Translate uses 450ms + fast_out_extra_slow_in
                 TranslateAnimation slide = new TranslateAnimation(
                         Animation.RELATIVE_TO_SELF, fromX,
                         Animation.RELATIVE_TO_SELF, toX,
                         Animation.RELATIVE_TO_SELF, 0f,
                         Animation.RELATIVE_TO_SELF, 0f
                 );
-                slide.setDuration(sSpatialSpec.getDurationMs());
-                slide.setInterpolator(sSpatialSpec);
+                slide.setDuration(TRANSLATE_DURATION_MS);
+                slide.setInterpolator(sAospTransitionInterpolator);
                 animationSet.addAnimation(slide);
+
+                // Alpha uses custom duration/offset + linear interpolator
                 if (fromAlpha != toAlpha) {
                     AlphaAnimation fade = new AlphaAnimation(fromAlpha, toAlpha);
-                    fade.setDuration(sEffectsSpec.getDurationMs());
-                    fade.setInterpolator(sEffectsSpec);
+                    fade.setDuration(alphaDuration);
+                    fade.setStartOffset(alphaOffset);
+                    fade.setInterpolator(sLinearInterpolator);
                     animationSet.addAnimation(fade);
                 }
+
                 animationSet.setShowBackdrop(true);
                 return animationSet;
             }
-- 
2.54.0

