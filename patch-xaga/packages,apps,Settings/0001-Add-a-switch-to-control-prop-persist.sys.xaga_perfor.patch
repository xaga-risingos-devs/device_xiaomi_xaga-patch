From 24cd0e205dca1b5bf14ecf643dd8968645f32dfe Mon Sep 17 00:00:00 2001
From: Hecheng Yu <kde-yyds@qq.com>
Date: Mon, 25 Aug 2025 09:20:25 +0800
Subject: [PATCH 1/3] Add a switch to control prop
 persist.sys.xaga_performance_mode

---
 res/xml/power_usage_summary.xml                     |  6 ++++++
 .../fuelgauge/batteryusage/PowerUsageSummary.java   | 13 ++++++++++++-
 2 files changed, 18 insertions(+), 1 deletion(-)

diff --git a/res/xml/power_usage_summary.xml b/res/xml/power_usage_summary.xml
index 950ca2d..183e2de 100644
--- a/res/xml/power_usage_summary.xml
+++ b/res/xml/power_usage_summary.xml
@@ -101,6 +101,12 @@
             settings:controller="com.android.settings.display.BatteryPercentagePreferenceController" />
     </com.android.settingslib.widget.UntitledPreferenceCategory>
 
+    <SwitchPreference
+        android:key="xaga_performance_mode"
+        android:title="Performance Mode"
+        android:summary="Turn off Cortex-A55 little cores to boost performance and save power"
+        android:defaultValue="true" />
+
     <Preference
         android:key="battery_info"
         android:title="@string/battery_info"
diff --git a/src/com/android/settings/fuelgauge/batteryusage/PowerUsageSummary.java b/src/com/android/settings/fuelgauge/batteryusage/PowerUsageSummary.java
index 60062da..a6024c6 100644
--- a/src/com/android/settings/fuelgauge/batteryusage/PowerUsageSummary.java
+++ b/src/com/android/settings/fuelgauge/batteryusage/PowerUsageSummary.java
@@ -25,6 +25,7 @@ import android.database.ContentObserver;
 import android.net.Uri;
 import android.os.Bundle;
 import android.os.Handler;
+import android.os.SystemProperties;
 import android.provider.Settings.Global;
 
 import androidx.annotation.NonNull;
@@ -33,6 +34,7 @@ import androidx.annotation.VisibleForTesting;
 import androidx.loader.app.LoaderManager;
 import androidx.loader.content.Loader;
 import androidx.preference.Preference;
+import androidx.preference.SwitchPreference;
 
 import com.android.settings.R;
 import com.android.settings.Utils;
@@ -145,7 +147,16 @@ public class PowerUsageSummary extends PowerUsageBase
 
         initFeatureProvider();
         initPreference();
-
+        SwitchPreference perfSwitch = findPreference("xaga_performance_mode");
+        if (perfSwitch != null) {
+            boolean enabled = SystemProperties.getBoolean("persist.sys.xaga_performance_mode", false);
+            perfSwitch.setChecked(enabled);
+            perfSwitch.setOnPreferenceChangeListener((preference, newValue) -> {
+                boolean checked = (Boolean) newValue;
+                SystemProperties.set("persist.sys.xaga_performance_mode", checked ? "1" : "0");
+                return true;
+            });
+        }
         mBatteryUtils = BatteryUtils.getInstance(getContext());
 
         if (Utils.isBatteryPresent(getContext())) {
-- 
2.52.0

