From 0215d9ea89a7c1844224fd35a20e3cceab9074da Mon Sep 17 00:00:00 2001
From: Hecheng Yu <kde-yyds@qq.com>
Date: Mon, 25 Aug 2025 09:20:25 +0800
Subject: [PATCH] Add a switch to control prop
 persist.sys.mt6895_performance_mode

---
 res/values-zh-rCN/performance_mode_strings.xml      |  4 ++++
 res/values/performance_mode_strings.xml             |  5 +++++
 res/xml/power_usage_summary.xml                     |  6 ++++++
 .../fuelgauge/batteryusage/PowerUsageSummary.java   | 13 ++++++++++++-
 4 files changed, 27 insertions(+), 1 deletion(-)
 create mode 100644 res/values-zh-rCN/performance_mode_strings.xml
 create mode 100644 res/values/performance_mode_strings.xml

diff --git a/res/values-zh-rCN/performance_mode_strings.xml b/res/values-zh-rCN/performance_mode_strings.xml
new file mode 100644
index 0000000..3c668b3
--- /dev/null
+++ b/res/values-zh-rCN/performance_mode_strings.xml
@@ -0,0 +1,4 @@
+<resources xmlns:xliff="urn:oasis:names:tc:xliff:document:1.2">
+    <string name="mt6895_performance_mode_title">性能模式</string>
+    <string name="mt6895_performance_mode_summary">关闭 Cortex-A55 小核以提升性能并降低功耗</string>
+</resources>
diff --git a/res/values/performance_mode_strings.xml b/res/values/performance_mode_strings.xml
new file mode 100644
index 0000000..6e931a5
--- /dev/null
+++ b/res/values/performance_mode_strings.xml
@@ -0,0 +1,5 @@
+<resources xmlns:xliff="urn:oasis:names:tc:xliff:document:1.2">
+    <!-- Performance mode toggle -->
+    <string name="mt6895_performance_mode_title">Performance Mode</string>
+    <string name="mt6895_performance_mode_summary">Turn off Cortex-A55 little cores to boost performance and save power</string>
+</resources>
diff --git a/res/xml/power_usage_summary.xml b/res/xml/power_usage_summary.xml
index b62a3db..108fdf4 100644
--- a/res/xml/power_usage_summary.xml
+++ b/res/xml/power_usage_summary.xml
@@ -101,6 +101,12 @@
             settings:controller="com.android.settings.display.BatteryPercentagePreferenceController" />
     </com.android.settingslib.widget.UntitledPreferenceCategory>
 
+    <SwitchPreference
+        android:key="mt6895_performance_mode"
+        android:title="@string/mt6895_performance_mode_title"
+        android:summary="@string/mt6895_performance_mode_summary"
+        android:defaultValue="true" />
+
     <Preference
         android:key="battery_info"
         android:title="@string/battery_info"
diff --git a/src/com/android/settings/fuelgauge/batteryusage/PowerUsageSummary.java b/src/com/android/settings/fuelgauge/batteryusage/PowerUsageSummary.java
index 60062da..731dcdf 100644
--- a/src/com/android/settings/fuelgauge/batteryusage/PowerUsageSummary.java
+++ b/src/com/android/settings/fuelgauge/batteryusage/PowerUsageSummary.java
@@ -25,6 +25,7 @@ import android.database.ContentObserver;
 import android.net.Uri;
 import android.os.Bundle;
 import android.os.Handler;
+import android.os.SystemProperties;
 import android.provider.Settings.Global;
 
 import androidx.annotation.NonNull;
@@ -33,6 +34,7 @@ import androidx.annotation.VisibleForTesting;
 import androidx.loader.app.LoaderManager;
 import androidx.loader.content.Loader;
 import androidx.preference.Preference;
+import androidx.preference.SwitchPreference;
 
 import com.android.settings.R;
 import com.android.settings.Utils;
@@ -145,7 +147,16 @@ public class PowerUsageSummary extends PowerUsageBase
 
         initFeatureProvider();
         initPreference();
-
+        SwitchPreference perfSwitch = findPreference("mt6895_performance_mode");
+        if (perfSwitch != null) {
+            boolean enabled = SystemProperties.getBoolean("persist.sys.mt6895_performance_mode", false);
+            perfSwitch.setChecked(enabled);
+            perfSwitch.setOnPreferenceChangeListener((preference, newValue) -> {
+                boolean checked = (Boolean) newValue;
+                SystemProperties.set("persist.sys.mt6895_performance_mode", checked ? "1" : "0");
+                return true;
+            });
+        }
         mBatteryUtils = BatteryUtils.getInstance(getContext());
 
         if (Utils.isBatteryPresent(getContext())) {
-- 
2.54.0

