+/**
+ * Defines a custom Interpolator for some animations.
+ *
+ */
+
+class OutExpoInterpolator implements Interpolator {
+    @Override
+    public float getInterpolation(float t) {
+        return (t == 1.0f) ? 1.0f : 1 - (float)Math.pow(2, -10 * t);
+    }
+}
