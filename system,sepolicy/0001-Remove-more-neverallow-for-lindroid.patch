From 9fcb616dd74df3969e78505b0a706ee9d67958bc Mon Sep 17 00:00:00 2001
From: Hecheng Yu <kde-yyds@qq.com>
Date: Sat, 24 Jan 2026 10:34:28 +0800
Subject: [PATCH] Remove more neverallow for lindroid

Change-Id: Ie084f2cec2b177fba6c58d283f00ee3b9e43cb05
---
 private/domain.te | 7 -------
 1 file changed, 7 deletions(-)

diff --git a/private/domain.te b/private/domain.te
index b1850c1..c1da5b0 100644
--- a/private/domain.te
+++ b/private/domain.te
@@ -2349,10 +2349,3 @@ neverallow domain *:system { kexec_image_load kexec_initramfs_load };
 # READING_X509_CERTIFICATE is not used.
 neverallow domain *:system x509_certificate_load;
 
-# attempts to write to /proc/self/fd/FOO, where FOO does not exist,
-# generates SELinux denials prior to being stopped by other parts of
-# the kernel. Disallow such nonsensical allow rules
-neverallow domain proc:filesystem associate;
-neverallow domain domain:dir { write add_name remove_name };
-neverallow domain domain:file create;
-
-- 
2.52.0

